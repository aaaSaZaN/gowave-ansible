{{ ansible_managed | comment }}
{% set environment = {
    'APP_SECRET': gowave_app_secret,
    'APP_HOST': '127.0.0.1',
    'APP_PORT': gowave_app_port | string,
    'PANEL_DOMAIN': gowave_panel_domain,
    'PANEL_BASE_PATH': gowave_panel_base_path,
    'FRONT_END_DOMAIN': gowave_front_end_domain,
    'SUB_PUBLIC_DOMAIN': gowave_sub_public_domain,
    'DB_DRIVER': gowave_db_driver,
    'DATABASE_URL': gowave_database_url,
    'METRICS_ENABLED': 'false'
} | combine(gowave_environment) %}
{% for key, value in environment | dictsort %}
{{ key }}={{ value | string | to_json(ensure_ascii=False) | replace('$', '\\$') }}
{% endfor %}
