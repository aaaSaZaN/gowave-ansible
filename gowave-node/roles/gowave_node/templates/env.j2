{{ ansible_managed | comment }}
{% set environment = {
    'SECRET_KEY': gowave_node_secret_key,
    'NODE_PORT': gowave_node_port | string,
    'GOWAVE_NODE_RUNTIME_DIR': '/run/gowave-node',
    'XRAY_CORE_PATH': gowave_node_install_dir ~ '/rw-core',
    'XRAY_LOCATION_ASSET': gowave_node_install_dir,
    'ASN_INDEX_PATH': gowave_node_install_dir ~ '/asn-prefixes.zip'
} | combine(gowave_node_environment) %}
{# LoadEnv strips outer quotes without interpreting escapes or expanding dollars. #}
{% for key, value in environment | dictsort %}
{{ key }}="{{ value | string }}"
{% endfor %}
